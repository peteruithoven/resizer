# Exposed separately so tests/meson.build can compile it into the test
# executable without pulling in the GTK-dependent sources.
image_geometry_sources = files('ImageGeometry.vala')

sources = image_geometry_sources + files(
    'Application.vala',
    'DropArea.vala',
    'HeaderBar.vala',
    'MessageCenter.vala',
    'ResizePage.vala',
    'Resizer.vala',
    'ResizingPage.vala',
    'Window.vala',
)
